    // curled cat
    '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#4F6858" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 40c0-12 9-21 20-21 9 0 14 6 16 13 1 5-1 9-5 9-3 0-4-3-7-3-6 0-9 4-15 4-4 0-9-1-9-2z" fill="#D9F5DA"/><circle cx="41" cy="27" r="1.5" fill="#4F6858" stroke="none"/><path d="M46 20l4-6-8 3"/><path d="M33 20l-2-6"/></g></svg>',
    // walking cat
    '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#4F6858" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 44c2-9 6-16 14-18 8-2 18 0 22 6 3 4 2 9-2 9-2 0-2-2-4-2-2 4-6 5-10 5-6 0-9 2-14 2-3 0-6-1-6-2z" fill="#A0E8B7"/><circle cx="41" cy="31" r="1.5" fill="#4F6858" stroke="none"/><path d="M46 25l4-5-7 2"/><path d="M18 44l-2 6M26 45l-1 6M40 42l2 6M46 40l3 5"/></g></svg>'
  ];

  var eggHost = document.getElementById('catEgg');
  var pickCat = cats[Math.floor(Math.random() * cats.length)];
  var wrap = document.createElement('div');
  wrap.className = 'cat-egg';
  wrap.innerHTML = pickCat;

  var top = 8 + Math.random() * 78;   // vh-ish percent
  var left = 6 + Math.random() * 82;  // vw-ish percent
  wrap.style.top = top + 'vh';
  wrap.style.left = left + 'vw';
  wrap.style.transform = 'rotate(' + (Math.random() * 24 - 12) + 'deg)';

  eggHost.appendChild(wrap);
