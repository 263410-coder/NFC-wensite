    "https://open.spotify.com/playlist/37i9dQZF1DX5LEXW9eXA0n?si=iM8OwcwyT9Wt27yunJsxdQ&utm_source=copy-link",
    "https://open.spotify.com/playlist/14WJZSvI3sDrXQsQmwWX35?si=KXtXmBuORQ2iclLiu-opHQ&utm_source=copy-link"
  ];

  document.querySelectorAll('.record[data-url]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.classList.add('spin-click');
      var url = btn.dataset.url;
      setTimeout(function () {
        window.open(url, '_blank', 'noopener');
      }, 260);
      setTimeout(function () {
        btn.classList.remove('spin-click');
      }, 500);
    });
  });

  var randomBtn = document.getElementById('randomBtn');
  randomBtn.addEventListener('click', function () {
    randomBtn.classList.add('spin-click');
    var pick = playlistUrls[Math.floor(Math.random() * playlistUrls.length)];
    setTimeout(function () {
      window.open(pick, '_blank', 'noopener');
