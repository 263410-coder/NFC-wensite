<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>오늘의 무드</title>
<style>
  :root {
    --pastel-mint: #8FE3A2;
    --pastel-pink: #B7EFC5;
    --pastel-lav: #6FCB8E;
    --pastel-peach: #D9F5DA;
    --pastel-sky: #A0E8B7;
    --pastel-butter: #C3ECC0;
    --pastel-coral: #4FBF74;
    --pastel-gray: #DCEFE0;
    --ink: #1E2E22;
    --ink-soft: #4F6858;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  html, body { height: 100%; margin: 0; }

  body {
    min-height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, "Malgun Gothic", "Apple SD Gothic Neo", sans-serif;
    color: var(--ink);
    position: relative;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 20px 48px;
  }

  /* background photo + pastel wash */
  .bg-photo {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    z-index: -3;
  }
  .bg-wash {
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(255,248,245,0.88) 0%, rgba(250,243,250,0.82) 45%, rgba(245,240,252,0.9) 100%);
    backdrop-filter: blur(2px);
  }

  /* cat easter egg */
  .cat-egg {
    position: fixed;
    width: 46px;
    height: 46px;
    z-index: -1;
    opacity: 0.55;
    pointer-events: none;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.12));
  }

  header {
    display: flex;
    justify-content: center;
    margin-bottom: 36px;
  }
  .logo {
    width: 40px;
    height: 40px;
  }

  main {
    width: 100%;
    max-width: 480px;
    flex: 1;
  }

  h1 {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 36px;
    text-align: center;
    color: var(--ink);
  }

  .record-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px 14px;
    justify-items: center;
  }

  .record {
    all: unset;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .vinyl {
    --accent: #ddd;
    position: relative;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle at center,
        #262229 0px, #262229 2px,
        #322d38 2px, #322d38 4px);
    box-shadow:
      0 8px 18px rgba(42, 39, 48, 0.18),
      inset 0 0 0 1px rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: float-wave 4.2s ease-in-out infinite;
    transform-origin: 50% 60%;
    transition: box-shadow 0.2s ease;
  }

  .label {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 3px rgba(42,39,48,0.9);
  }
  .label::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #262229;
  }
  .label svg { width: 20px; height: 20px; }
  .label .qmark {
    font-size: 17px;
    font-weight: 800;
    color: var(--ink);
  }

  .record-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-soft);
  }

  /* staggered idle wave */
  .record-grid .record:nth-child(1) .vinyl { animation-delay: 0s; }
  .record-grid .record:nth-child(2) .vinyl { animation-delay: .3s; }
  .record-grid .record:nth-child(3) .vinyl { animation-delay: .6s; }
  .record-grid .record:nth-child(4) .vinyl { animation-delay: .9s; }
  .record-grid .record:nth-child(5) .vinyl { animation-delay: 1.2s; }
  .record-grid .record:nth-child(6) .vinyl { animation-delay: 1.5s; }
  .record-grid .record:nth-child(7) .vinyl { animation-delay: 1.8s; }
  .record-grid .record:nth-child(8) .vinyl { animation-delay: 2.1s; }

  @keyframes float-wave {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%      { transform: translateY(-5px) rotate(3deg); }
  }

  .record:hover .vinyl,
  .record:focus-visible .vinyl {
    box-shadow:
      0 12px 22px rgba(42, 39, 48, 0.24),
      inset 0 0 0 1px rgba(255,255,255,0.08);
  }
  .record:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 50%;
  }

  .record.spin-click .vinyl {
    animation: spin-wave 0.5s cubic-bezier(.36,.07,.19,.97);
  }
  @keyframes spin-wave {
    0%   { transform: rotate(-3deg) scale(1); }
    30%  { transform: rotate(18deg) scale(1.12); }
    60%  { transform: rotate(-10deg) scale(0.96); }
    100% { transform: rotate(-3deg) scale(1); }
  }

  footer {
    margin-top: 44px;
    color: var(--ink-soft);
    font-size: 12px;
    text-align: center;
    opacity: 0.7;
  }

  @media (max-width: 380px) {
    .vinyl { width: 76px; height: 76px; }
    .label { width: 34px; height: 34px; }
    h1 { font-size: 21px; }
    .record-grid { gap: 20px 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl, .record.spin-click .vinyl { animation: none !important; }
  }
</style>
</head>
